        <mxCell id="nota_vistas" value="&lt;b&gt;Vistas&lt;/b&gt; (datos calculados: no se guardan, se obtienen al consultar)&lt;br&gt;&lt;br&gt;&lt;b&gt;v_cargo&lt;/b&gt;: cada cargo con lo pagado, su saldo y su estado (pendiente, parcial, pagado o vencido)&lt;br&gt;&lt;br&gt;&lt;b&gt;v_departamento&lt;/b&gt;: cada departamento con su tipo y cuota, su propietario actual, su deuda y su saldo a favor&lt;br&gt;&lt;br&gt;&lt;b&gt;v_ingreso&lt;/b&gt;: cada pago con lo que ya se aplicó a cargos y lo que queda como saldo a favor" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="100" y="610" width="290" height="196" as="geometry"/></mxCell>
        <mxCell id="nota_unicas" value="&lt;b&gt;Combinaciones que no se repiten&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;cargo&lt;/b&gt;: id_departamento + periodo + concepto&lt;br&gt;&lt;b&gt;departamento&lt;/b&gt;: id_condominio + numero&lt;br&gt;&lt;b&gt;egreso&lt;/b&gt;: id_condominio + numero&lt;br&gt;&lt;b&gt;ingreso&lt;/b&gt;: id_condominio + numero&lt;br&gt;&lt;b&gt;ingreso_cargo&lt;/b&gt;: id_ingreso + id_cargo&lt;br&gt;&lt;b&gt;tipo_departamento&lt;/b&gt;: id_condominio + nombre" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#cbd5e1;align=left;verticalAlign=top;spacing=12;fontSize=11;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="100" y="826" width="290" height="150" as="geometry"/></mxCell>
