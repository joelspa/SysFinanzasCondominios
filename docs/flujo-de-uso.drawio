        <mxCell id="b3" value="Registrar los gastos, con su factura o recibo&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Gastos&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="400" width="200" height="110" as="geometry"/></mxCell>
