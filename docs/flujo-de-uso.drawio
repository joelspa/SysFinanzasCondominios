        <mxCell id="b5_n" value="12" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1f5fc4;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1248" y="387" width="28" height="28" as="geometry"/></mxCell>
