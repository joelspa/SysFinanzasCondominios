        <mxCell id="titulo" value="&lt;b&gt;Cómo se usa el sistema&lt;/b&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#0f172a;fontSize=24;" vertex="1" parent="1"><mxGeometry x="30" y="14" width="500" height="34" as="geometry"/></mxCell>
        <mxCell id="subtitulo" value="Finanzas de Condominios · el recorrido de trabajo, desde preparar el condominio hasta cerrar cada mes" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontColor=#0f172a;fontSize=13;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="390" y="18" width="900" height="28" as="geometry"/></mxCell>
