        <mxCell id="paso_a_mes" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a5" target="b0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1580" y="290"/><mxPoint x="44" y="290"/><mxPoint x="44" y="455"/></Array></mxGeometry></mxCell>
        <mxCell id="repetir" value="El mes siguiente se repite" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1f5fc4;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;" edge="1" parent="1" source="b6" target="b0"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1600" y="366"/><mxPoint x="160" y="366"/></Array></mxGeometry></mxCell>
        <mxCell id="cuanto" value="¿Cuánto pagó?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fef5e1;strokeColor=#b45309;strokeWidth=1.6;fontSize=13;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="540" y="548" width="200" height="104" as="geometry"/></mxCell>
        <mxCell id="f_cuanto" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="cuanto"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="parte" value="&lt;b&gt;Queda debiendo el resto.&lt;/b&gt;&lt;br&gt;Si pasa la fecha de vencimiento, el departamento aparece en mora." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef5e1;strokeColor=#b45309;strokeWidth=1.4;fontSize=12;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="236" y="712" width="264" height="112" as="geometry"/></mxCell>
        <mxCell id="todo" value="&lt;b&gt;El departamento queda al día.&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e7f6e7;strokeColor=#2e7d32;strokeWidth=1.4;fontSize=12;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="520" y="712" width="240" height="112" as="geometry"/></mxCell>
        <mxCell id="demas" value="&lt;b&gt;Lo que sobra queda a favor&lt;/b&gt; y se descuenta solo de la próxima expensa. También se pueden pagar meses por adelantado." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#eaf1fc;strokeColor=#1f5fc4;strokeWidth=1.4;fontSize=12;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="780" y="712" width="280" height="112" as="geometry"/></mxCell>
        <mxCell id="f_parte" value="una parte" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cuanto" target="parte"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f_todo" value="todo" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cuanto" target="todo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="f_demas" value="de más" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="cuanto" target="demas"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="panel" value="&lt;b&gt;En cualquier momento, el panel principal muestra:&lt;/b&gt;&lt;br&gt;&lt;br&gt;• Cuánto dinero hay disponible, en caja y en el banco&lt;br&gt;• Cuánto falta cobrar y qué departamentos están en mora&lt;br&gt;• Un aviso si todavía no se generaron las expensas del mes&lt;br&gt;• Los últimos pagos y gastos registrados" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eaf1fc;strokeColor=#b9cdf0;align=left;verticalAlign=top;spacing=16;fontSize=13;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="1120" y="560" width="580" height="150" as="geometry"/></mxCell>
        <mxCell id="banda3" value="3 · Cuando haga falta" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f6fa;strokeColor=#d6dae2;verticalAlign=top;align=left;spacingLeft=44;spacingTop=12;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="880" width="1700" height="268" as="geometry"/></mxCell>
        <mxCell id="s0" value="Se vende un departamento" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontSize=12;fontStyle=1;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="60" y="936" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c0" value="Registrar el traspaso: el nuevo dueño asume la deuda pendiente&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Ficha del departamento → Traspasar propiedad&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="1024" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="sf0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s0" target="c0"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s1" value="Hay un error en un recibo o en un gasto" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontSize=12;fontStyle=1;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="395" y="936" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c1" value="Anularlo indicando el motivo y registrar uno nuevo; el anulado queda en el historial&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Ingresos o Gastos → Anular&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="395" y="1024" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="sf1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s2" value="Hay que cobrar algo extra: una multa o una cuota extraordinaria" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontSize=12;fontStyle=1;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="730" y="936" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c2" value="Crear un cargo nuevo para ese departamento&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Cuentas por cobrar → Nuevo cargo&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="730" y="1024" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="sf2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s3" value="Entra dinero que no es de un departamento (alquiler del salón, intereses)" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontSize=12;fontStyle=1;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="1065" y="936" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c3" value="Registrarlo como ingreso sin departamento&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Ingresos → Registrar pago&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="1065" y="1024" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="sf3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="s4" value="Se administra otro condominio o llega un tesorero nuevo" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#94a3b8;fontSize=12;fontStyle=1;fontColor=#0f172a;spacing=8;" vertex="1" parent="1"><mxGeometry x="1400" y="936" width="300" height="62" as="geometry"/></mxCell>
        <mxCell id="c4" value="El administrador lo crea y le asigna sus condominios&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Condominios y Usuarios&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="1400" y="1024" width="300" height="104" as="geometry"/></mxCell>
        <mxCell id="sf4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#475569;strokeWidth=1.6;endArrow=block;endFill=1;endSize=7;fontSize=12;fontColor=#0f172a;labelBackgroundColor=#f4f6fa;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="c4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
