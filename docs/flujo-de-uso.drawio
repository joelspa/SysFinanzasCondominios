        <mxCell id="banda2" value="2 · Todos los meses" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#f4f6fa;strokeColor=#d6dae2;verticalAlign=top;align=left;spacingLeft=44;spacingTop=12;fontSize=16;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1"><mxGeometry x="30" y="305" width="1700" height="545" as="geometry"/></mxCell>
        <mxCell id="quien2" value="Lo hace el tesorero o el administrador" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#0f172a;strokeColor=none;fontColor=#ffffff;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1420" y="317" width="290" height="26" as="geometry"/></mxCell>
        <mxCell id="b0" value="Generar las expensas del mes para todos los departamentos&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Cuentas por cobrar&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="60" y="400" width="200" height="110" as="geometry"/></mxCell>
