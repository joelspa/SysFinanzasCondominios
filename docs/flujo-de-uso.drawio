        <mxCell id="b1" value="Repartir los avisos de cobranza&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Cuentas por cobrar&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="300" y="400" width="200" height="110" as="geometry"/></mxCell>
