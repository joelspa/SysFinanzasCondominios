        <mxCell id="a2" value="Completar los datos del condominio y la cuota mensual de cada tipo de departamento&lt;br&gt;&lt;font color=&quot;#64748b&quot; style=&quot;font-size: 11px;&quot;&gt;Menú: Configuración&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#1f5fc4;strokeWidth=1.6;fontSize=13;fontColor=#0f172a;spacing=10;" vertex="1" parent="1"><mxGeometry x="620" y="134" width="240" height="110" as="geometry"/></mxCell>
